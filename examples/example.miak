make i:int = 5;

fn checkAddition(a:int, b:int = 5):bool {
    if (a + b) =? 3 {
        RET true;
    }
    RET false;
}

main:int {
    i = 9;
    print(i);                               # 9, no newline
    make b:bool = checkAddition(i, -6);
    print(b);                               # true, so the first line is 9true9
    while i <=? 15 {
        print(i);                           # 9 10 11 12 13 14 15, one per line
        print("\n");
        i = i + 1;
    }
    RET 0;
}
